{
  "name": "calendariogem",
  "private": true,
  "version": "0.1.0",
  "description": "Calendario empresarial GEM: recordatorios y eventos propios y compartidos, etiquetas entre colaboradores y notificaciones.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "test:agente": "powershell -NoProfile -ExecutionPolicy Bypass -File agente/pruebas.ps1",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "db:types": "supabase gen types typescript --local > src/types/database.types.ts",
    "remoto": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/remoto.ps1",
    "check": "npm run lint && npm run typecheck && npm run test && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "supabase": "^2.122.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
