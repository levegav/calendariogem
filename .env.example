# Copie este archivo como .env.local y complete los valores.
# Solo variables PÚBLICAS: todo lo que empiece con VITE_ queda visible en el navegador.
# NUNCA coloque aquí la clave secreta (sb_secret_...) ni la service_role.

# Supabase > Project Settings > Data API > Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
